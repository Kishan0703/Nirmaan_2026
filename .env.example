# Server-only admin credentials.
ADMIN_USERNAME=adminusername
ADMIN_PASSWORD=adminpassword

# Server-only secrets. Generate unique random values; never use the values in this file as real credentials.
AUTH_SECRET=replace-with-a-unique-random-value-of-at-least-32-bytes
WEBHOOK_SECRET=replace-with-a-unique-random-value-of-at-least-32-bytes

# Server-only database connection string. Leave unset to use the local development data store.
DATABASE_URL=

# Public configuration only; values prefixed NEXT_PUBLIC_ are embedded into browser bundles.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REGISTRATION_URL=https://example.com/register

